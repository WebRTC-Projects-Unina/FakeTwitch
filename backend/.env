# Porta del server Node.js (HTTP REST + WebSocket)
PORT=4000
NODE_ENV=development

# Origine del Frontend abilitata per l'invio dei Cookie HttpOnly (CORS)
FRONTEND_URL=http://localhost:80

# Credenziali Database MySQL (Container Docker)
DB_HOST=172.28.0.20
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=streaming_db

# Chiave Segreta Server-to-Server condivisa con <SecretKey> nel Server.xml di OvenMediaEngine
OME_WEBHOOK_SECRET=chiave_segreta_hmac_esame

# URL pubblico RTMP mostrato nella dashboard per configurare OBS Studio
OBS_RTMP_URL=rtmp://localhost:1935/app